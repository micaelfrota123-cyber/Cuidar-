# =============================================================================
# ARQUIVO DE EXEMPLO DE VARIÁVEIS DE AMBIENTE - CUIDAR+
# Copie este arquivo para .env e preencha com as suas configurações locais
# =============================================================================

# Porta do Servidor Web Local (Padrão do projeto: 3011)
PORT=3011

# Ambiente de Execução (development, test, production)
NODE_ENV=development

# Configurações do Banco de Dados Relacional (PostgreSQL / MySQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cuidar_mais
DB_USER=postgres
DB_PASS=sua_senha_aqui

# Segredo de Assinatura para Tokens de Sessão / JWT
JWT_SECRET=cuidarmais_secret_token_exemplo_2026

# Habilitar Modo Demonstração Pré-Carregado (true/false)
DEMO_SEED_AUTO_LOAD=true
